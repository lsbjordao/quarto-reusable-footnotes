<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text">
  <info>
    <title>Bibentry test style</title>
    <id>https://example.invalid/bibentry-test</id>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " name-as-sort-order="all"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation>
    <layout prefix="INLINE[" suffix="]">
      <text macro="author"/>
      <text macro="year" prefix=" "/>
    </layout>
  </citation>
  <bibliography>
    <layout prefix="FULL[" suffix="]">
      <text macro="author"/>
      <text variable="title" prefix=" — " font-style="italic"/>
      <text macro="year" prefix=" — "/>
    </layout>
  </bibliography>
</style>
